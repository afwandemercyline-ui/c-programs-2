#include <iostream>
#include <cstdlib>
#include <ctime>
using namespace std;

int main() {
    // ----------------------------------------------------
    // 1D Array - Weekly Revenue Tracker (7 days)
    // ----------------------------------------------------
    double revenue[7];
    double totalRevenue = 0;
    
    cout << "=== 1D Array: Weekly Revenue Tracker ===" << endl;
    for (int i = 0; i < 7; i++) {
        cout << "Enter revenue for day " << (i + 1) << ": ";
        cin >> revenue[i];
        totalRevenue += revenue[i];
    }
    double avgRevenue = totalRevenue / 7.0;
    cout << "Total Weekly Revenue: " << totalRevenue << endl;
    cout << "Average Daily Revenue: " << avgRevenue << "\n\n";

    // ----------------------------------------------------
    // 2D Array - Room Occupancy (One Branch: 5 floors, 10 rooms)
    // ----------------------------------------------------
    int occupancy[5][10];
    srand(time(0)); // Seed for random values
    
    cout << "=== 2D Array: Room Occupancy (One Branch) ===" << endl;
    for (int i = 0; i < 5; i++) {
        int occupiedCount = 0, vacantCount = 0;
        for (int j = 0; j < 10; j++) {
            occupancy[i][j] = rand() % 2; // Random 1 (occupied) or 0 (vacant)
            if (occupancy[i][j] == 1) {
                occupiedCount++;
            } else {
                vacantCount++;
            }
        }
        cout << "Floor " << (i + 1) << " -> Occupied: " << occupiedCount << " | Vacant: " << vacantCount << endl;
    }
    cout << "\n";

    // ----------------------------------------------------
    // 3D Array - Multiple Branches (3 branches, 5 floors, 10 rooms)
    // ----------------------------------------------------
    int chain[3][5][10];
    int totalOccupiedChain = 0;

    cout << "=== 3D Array: Multiple Branches ===" << endl;
    for (int b = 0; b < 3; b++) {
        for (int f = 0; f < 5; f++) {
            for (int r = 0; r < 10; r++) {
                chain[b][f][r] = rand() % 2;
                if (chain[b][f][r] == 1) {
                    totalOccupiedChain++;
                }
            }
        }
    }
    cout << "Total number of occupied rooms across all 3 branches: " << totalOccupiedChain << endl;

    return 0;
}
